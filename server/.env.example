# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (either DATABASE_URL for hosted PG, or discrete vars for local)
DATABASE_URL=postgresql://user:password@localhost:5432/appointment_ai
# PGSSL=true   # uncomment when connecting to a hosted DB that requires SSL (Render/Railway/Neon)

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# AI Provider (Mistral)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
